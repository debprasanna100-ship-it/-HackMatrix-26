# TrustLens backend configuration. Copy to .env and adjust.
# All settings use the TRUSTLENS_ prefix; unset values fall back to safe defaults.

# development | production
TRUSTLENS_ENVIRONMENT=development

# SQLite for local dev; switch to PostgreSQL for production:
# TRUSTLENS_DATABASE_URL=postgresql+psycopg://trustlens:secret@localhost:5432/trustlens
TRUSTLENS_DATABASE_URL=sqlite:///./trustlens.db

# CORS origins for the React dev server (Phase 3). JSON list when set via env.
# TRUSTLENS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Rate limit: requests per minute per client IP on /api/* routes.
TRUSTLENS_RATE_LIMIT_PER_MINUTE=10
# Set to true ONLY when running behind a trusted reverse proxy (nginx, Caddy, etc.)
TRUSTLENS_TRUST_PROXY_HEADERS=false

# Safe-fetch pipeline limits
TRUSTLENS_FETCH_MAX_REDIRECTS=5
TRUSTLENS_FETCH_CONNECT_TIMEOUT=5.0
TRUSTLENS_FETCH_READ_TIMEOUT=10.0
TRUSTLENS_FETCH_TOTAL_BUDGET=40.0
TRUSTLENS_FETCH_MAX_BYTES=1000000

# Only these ports may be fetched (SSRF policy).
TRUSTLENS_ALLOWED_FETCH_PORTS=[80,443]

# --- Time budgets (audit M2) ---
# Wall-clock budget (seconds) for the threat-intel stage of ONE URL analysis
# (domain + URL pass combined). Expiry = failed coverage (INTEL-BUDGET-EXCEEDED),
# never a clean answer; answers obtained before it are kept. 0 disables.
TRUSTLENS_INTEL_BUDGET_SECONDS=60
# Aggregate budget (seconds) for running a message's embedded URLs through the
# full pipeline. URLs past it are skipped (MSG-URL-SKIPPED). 0 disables.
TRUSTLENS_MESSAGE_URL_BUDGET_SECONDS=240

# --- Threat-intel provider keys (adapters follow the official provider docs) ---
# Google Safe Browsing v4 authenticates with its documented `key` query
# parameter (the threatMatches:find endpoint refuses header-based identity).
# VirusTotal v3 uses the x-apikey header — that key is never placed in URLs.
# TRUSTLENS_GOOGLE_SAFE_BROWSING_API_KEY=
# TRUSTLENS_VIRUSTOTAL_API_KEY=
# URLhaus v1 (Auth-Key header; key optional for low rates).
# TRUSTLENS_URLHAUS_API_KEY=
# PhishTank v2 checkurl (app_key in the POST body); only verified+valid
# records count as authoritative matches.
# TRUSTLENS_PHISHTANK_API_KEY=
# OpenPhish: the official community feed needs no key; set any non-empty value
# (e.g. "community") to switch the provider on. The value is never sent anywhere.
# TRUSTLENS_OPENPHISH_API_KEY=

# Report retention (privacy): purge stored reports (+ indicators + commitments)
# older than N days at startup. 0 keeps everything.
# TRUSTLENS_REPORT_RETENTION_DAYS=30

# --- DNS resolution for the passive record checks ---
# Fall back to RFC 8484 DNS-over-HTTPS (port 443; Cloudflare then Google) when
# the system resolver (UDP/TCP 53) fails. The SSRF-safe fetcher is unaffected.
TRUSTLENS_DNS_USE_DOH=true
TRUSTLENS_DNS_TIMEOUT=3.0

# --- VirusTotal v3 miss policy ---
# On URL 404 (never analysed): query the domain object passively (default on);
# optionally POST the URL for scanning (opt-in, ACTIVE, costs quota).
TRUSTLENS_VT_DOMAIN_FALLBACK=true
TRUSTLENS_VT_SUBMIT_ON_MISS=false

# --- Multi-tenant authentication (default: off = frictionless demo mode) ---
# true: Bearer JWT or X-API-Key required; reports are owner-scoped (public
# ones readable by all authenticated users); DELETE/commit owner-only.
# TRUSTLENS_AUTH_REQUIRED=true
# HS256 signing secret - at least 32 bytes of entropy (RFC 7518):
# TRUSTLENS_JWT_SECRET=
# TRUSTLENS_ACCESS_TOKEN_EXPIRY_MINUTES=480
# Hardened bootstrap: create the administrator explicitly (idempotent at
# startup, or via `python -m app.storage.seed`). Admin rights are NEVER
# granted to the first arbitrary registration.
# TRUSTLENS_INITIAL_ADMIN_EMAIL=admin@example.com
# TRUSTLENS_INITIAL_ADMIN_PASSWORD=change-me-immediately
# Self-registration while auth is enabled (default: closed; admins always can
# create users).
# TRUSTLENS_ALLOW_OPEN_REGISTRATION=false

# VirusTotal active-submission budget (per rolling hour) when
# TRUSTLENS_VT_SUBMIT_ON_MISS=true.
# TRUSTLENS_VT_SUBMIT_MAX_PER_HOUR=10

# --- AI layer (Phase 5, optional) ---
# Provider-agnostic OpenAI-compatible endpoint. Works with OpenAI, DeepSeek,
# Moonshot/Kimi, Z.ai/GLM, OpenRouter, or a local Ollama/vLLM by changing
# base_url + model. With NO key set, TrustLens uses the deterministic
# rule-based explainer — every feature still works, just without AI prose.
# TRUSTLENS_LLM_API_KEY=sk-...
# TRUSTLENS_LLM_BASE_URL=https://api.openai.com/v1
# TRUSTLENS_LLM_MODEL=gpt-4o-mini
# TRUSTLENS_LLM_TIMEOUT_SECONDS=25

# --- Web3 threat registry (Phase 4) ---
# Local Hardhat node by default. Chain features activate only when the
# registry address is set; without it, commit returns 503 and verify still
# reports the recomputed hash (graceful degradation).
TRUSTLENS_CHAIN_RPC_URL=http://127.0.0.1:8545
# After `npm run deploy:local` in /contracts, copy the address from
# contracts/deployment.localhost.json:
# TRUSTLENS_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Funded Hardhat test account #0 — LOCAL TEST CHAIN ONLY, never a real key:
# TRUSTLENS_CHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Alternative wiring (used by docker-compose): point at a deployment JSON and
# the contract address is auto-discovered when TRUSTLENS_REGISTRY_ADDRESS is empty.
# TRUSTLENS_DEPLOYMENT_FILE=/shared/deployment.localhost.json
